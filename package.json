{
  "name": "captioncat",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Browser extension for caption skins, hover translation and vocabulary collection",
  "scripts": {
    "build": "node scripts/build.mjs",
